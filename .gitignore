# Build artefacts
node_modules/
dist/
build/
.turbo/
.next/
.cache/
.output/
.wxt/
web-ext-artifacts/
.tsbuildinfo
*.tsbuildinfo
coverage/

# Env / secrets — NEVER commit
.env
.env.*
!.env.example
*.env
**/mnemonic.txt
**/seed.txt
**/recovery.txt
**/secrets/

# Signing / crypto keys — NEVER commit
*.pem
*.key
*-priv.pem
mcuboot_priv.pem
*.keystore
!debug.keystore
*.jks
*.p12
*.mobileprovision

# Service / CLI auth
.tursorc
.netlify/

# Logs / OS junk
*.log
.DS_Store
Thumbs.db
.pnpm-store/

# IDE — keep shared config, ignore machine-specific
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/

# 릴리스 산출물 APK (scripts/gradle.mjs 가 build.gradle 의 versionName 으로 이름을 조립).
# 버전이 바뀌어도 잡히도록 접미사 와일드카드. 5.5MB 바이너리라 저장소에 넣지 않는다.
# .manifest.json 은 공개 검증 근거라 추적 대상 — .apk 로 끝나는 것만 무시된다.
/벼린*.apk

# 실기기 전송용 압축본 — 벼린.apk 를 담은 사본이라 저장소에 둘 이유가 없다
벼린.zip
*.apk.zip

# 배포 키 파일 — 절대 커밋 금지 (권한 위임 시에만 잠시 존재)
.deploy-key
