{
  "name": "@byeorin/extension",
  "version": "0.5.23",
  "private": true,
  "type": "module",
  "description": "벼린 — 브라우저 확장 (MV3, EIP-1193)",
  "scripts": {
    "dev": "wxt",
    "build": "pnpm -r --filter @byeorin/extension^... build && wxt build",
    "build:icons": "node scripts/build-icons.mjs",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts"
  },
  "dependencies": {
    "@byeorin/design-system": "workspace:*",
    "@byeorin/i18n": "workspace:*",
    "@byeorin/shell-core": "workspace:*",
    "@byeorin/wallet-sdk": "workspace:*",
    "buffer": "^6.0.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.0.279",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@wxt-dev/module-react": "^1.1.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "wxt": "^0.19.13"
  }
}
