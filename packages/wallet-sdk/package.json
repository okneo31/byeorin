{
  "name": "@nodong/wallet-sdk",
  "version": "0.0.1",
  "description": "노동자의 지갑 코어 SDK — 멀티체인(EVM/BTC/XRP/Cosmos+) HD 월릿",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./evm": {
      "types": "./dist/evm.d.ts",
      "import": "./dist/evm.js",
      "require": "./dist/evm.cjs"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo .tsbuildinfo"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^7.0.1",
    "@cosmjs/amino": "^0.32.4",
    "@cosmjs/encoding": "^0.32.4",
    "@cosmjs/proto-signing": "^0.32.4",
    "@cosmjs/stargate": "^0.32.4",
    "@mysten/sui": "^1.18.0",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "@scure/base": "^1.1.9",
    "@scure/bip32": "^1.5.0",
    "@scure/bip39": "^1.4.0",
    "@scure/btc-signer": "^1.5.0",
    "@solana/web3.js": "^1.95.5",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^15.1.0",
    "tronweb": "^6.0.0",
    "viem": "^2.21.40",
    "xrpl": "^4.0.0"
  },
  "optionalDependencies": {
    "@reown/walletkit": "^1.5.5",
    "@ledgerhq/hw-app-cosmos": "^6.30.0",
    "@ledgerhq/hw-app-solana": "^7.2.0",
    "@ledgerhq/hw-transport": "^6.31.0",
    "@ledgerhq/hw-transport-webhid": "^6.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
