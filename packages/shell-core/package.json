{
  "name": "@byeorin/shell-core",
  "version": "0.0.1",
  "description": "벼린 — 앱 셸 공용 코어 (월릿 라이프사이클 + 세션 스토어)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo .tsbuildinfo"
  },
  "dependencies": {
    "@byeorin/wallet-sdk": "workspace:*",
    "@noble/hashes": "^1.5.0",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "qrcode": "^1.5.4",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  }
}
